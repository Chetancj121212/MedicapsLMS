# Database (PostgreSQL with asyncpg)
DATABASE_URL=postgresql+asyncpg://postgres:replace-with-a-local-password@localhost:5432/medicaps_lms
DATA_DIR=../data
SECRET_KEY=replace-with-a-local-secret
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7
UPLOAD_DIR=../data/uploads
VIDEO_UPLOAD_DIR=../data/uploads/videos
CERTIFICATE_DIR=../data/certificates
MAX_VIDEO_SIZE_MB=500
BASE_URL=https://apimedicapslms.chetancj.in
FRONTEND_URL=https://medicapslms.chetancj.in
CORS_ORIGINS=["http://localhost:3000","https://medicapslms.chetancj.in"]