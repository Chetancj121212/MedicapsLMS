# Docker Compose ports
FRONTEND_PORT=3000
BACKEND_PORT=8000
POSTGRES_PORT=5432

# PostgreSQL configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace-with-a-secure-database-password
POSTGRES_DB=medicaps_lms
DATABASE_URL=postgresql+asyncpg://postgres:replace-with-a-secure-database-password@db:5432/medicaps_lms

# Public browser-facing API URL
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_BACKUP_API_URL=http://localhost:8000

# Backend settings
SECRET_KEY=replace-with-a-long-random-secret
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7
MAX_VIDEO_SIZE_MB=500
BASE_URL=http://localhost:8000
FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=["http://localhost:3000"]
